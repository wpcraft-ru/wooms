{
    "name": "wpcraft-ru/wooms",
    "authors": [
        {
            "name": "ai",
            "email": "m@wpcraft.ru"
        }
    ],
    "require": {},
    "require-dev": {
        "brain/monkey": "^2.4",
        "phpunit/phpunit": "^9.0",
        "yoast/phpunit-polyfills": "^1.0"
    },
    "scripts": {
        "dev-start": "wp-env start --runtime=playground",
        "dev-start-update": "wp-env start --runtime=playground --update",
        "dev-start-docker": "npx wp-env start",
        "dev-stop": "wp-env stop",
        "dev-restart": "wp-env start --update",
        "cli": "wp-env run cli",
        "test": "wp-env run cli --env-cwd=wp-content/plugins/wooms phpunit",
        "lint": "wp-env run cli --env-cwd=wp-content/plugins/wooms phpcs"
    }
}
